{
  "name": "md-review",
  "displayName": "MD Review",
  "description": "Write and review Markdown in a continuous live canvas with autosave, contextual comment threads, and an AI-agent review workflow. Comments stay in a portable JSON sidecar.",
  "version": "0.1.0",
  "publisher": "mustafaakben",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In a folder you haven't trusted, Send to Claude only copies the review prompt (Claude Code would load the folder's own settings and hooks), Add Claude Code Skill is off, the review inbox lists threads without Send All, and Export to Word reads images only from the document's folder and the workspace.",
      "restrictedConfigurations": [
        "mdReview.agent.command",
        "mdReview.agent.launch"
      ]
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "MD Review reads and writes the Markdown file and its comments on disk."
    }
  },
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdReview.editor",
        "displayName": "MD Review",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "mdReview.inbox",
          "name": "MD Review",
          "icon": "$(comment-discussion)",
          "contextualTitle": "MD Review",
          "visibility": "collapsed",
          "when": "workspaceFolderCount > 0"
        }
      ]
    },
    "commands": [
      {
        "command": "mdReview.open",
        "title": "Open in MD Review",
        "category": "MD Review",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "mdReview.openSource",
        "title": "Open Markdown Source",
        "category": "MD Review",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mdReview.undo",
        "title": "Undo Edit",
        "category": "MD Review"
      },
      {
        "command": "mdReview.redo",
        "title": "Redo Edit",
        "category": "MD Review"
      },
      {
        "command": "mdReview.find",
        "title": "Find in Document",
        "category": "MD Review"
      },
      {
        "command": "mdReview.nextComment",
        "title": "Next Comment",
        "category": "MD Review"
      },
      {
        "command": "mdReview.previousComment",
        "title": "Previous Comment",
        "category": "MD Review"
      },
      {
        "command": "mdReview.nextChange",
        "title": "Next Change",
        "category": "MD Review"
      },
      {
        "command": "mdReview.previousChange",
        "title": "Previous Change",
        "category": "MD Review"
      },
      {
        "command": "mdReview.toggleOutline",
        "title": "Toggle Outline",
        "category": "MD Review",
        "icon": "$(list-tree)"
      },
      {
        "command": "mdReview.addComment",
        "title": "Comment on Selection",
        "category": "MD Review"
      },
      {
        "command": "mdReview.replyToThread",
        "title": "Reply to Current Thread",
        "category": "MD Review"
      },
      {
        "command": "mdReview.submitReview",
        "title": "Submit Review",
        "category": "MD Review"
      },
      {
        "command": "mdReview.toggleComments",
        "title": "Toggle Comments Pane",
        "category": "MD Review"
      },
      {
        "command": "mdReview.showShortcuts",
        "title": "Keyboard Shortcuts",
        "category": "MD Review"
      },
      {
        "command": "mdReview.severity1",
        "title": "Mark Comment Major",
        "category": "MD Review"
      },
      {
        "command": "mdReview.severity2",
        "title": "Mark Comment Minor",
        "category": "MD Review"
      },
      {
        "command": "mdReview.severity3",
        "title": "Mark Comment Nit",
        "category": "MD Review"
      },
      {
        "command": "mdReview.sendToClaude",
        "title": "Send Review to Claude",
        "category": "MD Review",
        "icon": "$(sparkle)"
      },
      {
        "command": "mdReview.reviewWithClaude",
        "title": "Review with Claude",
        "category": "MD Review",
        "icon": "$(sparkle)"
      },
      {
        "command": "mdReview.sendFolderToClaude",
        "title": "Send Open Reviews in Folder to Claude",
        "category": "MD Review",
        "icon": "$(sparkle)"
      },
      {
        "command": "mdReview.addClaudeSkill",
        "title": "Add Claude Code Skill to Workspace",
        "category": "MD Review"
      },
      {
        "command": "mdReview.exportWord",
        "title": "Export to Word (with comments)",
        "category": "MD Review"
      },
      {
        "command": "mdReview.importWord",
        "title": "Import Comments from Word…",
        "category": "MD Review"
      },
      {
        "command": "mdReview.zoomIn",
        "title": "Zoom In (Document)",
        "category": "MD Review"
      },
      {
        "command": "mdReview.zoomOut",
        "title": "Zoom Out (Document)",
        "category": "MD Review"
      },
      {
        "command": "mdReview.zoomReset",
        "title": "Reset Zoom (Document)",
        "category": "MD Review"
      },
      {
        "command": "mdReview.readingView",
        "title": "Reading Theme, Font, and Zoom…",
        "category": "MD Review"
      },
      {
        "command": "mdReview.inbox.refresh",
        "title": "Refresh",
        "category": "MD Review",
        "icon": "$(refresh)"
      },
      {
        "command": "mdReview.inbox.sendAll",
        "title": "Send All to Claude",
        "category": "MD Review",
        "icon": "$(sparkle)"
      },
      {
        "command": "mdReview.openThread",
        "title": "Open Thread",
        "category": "MD Review"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdReview.open",
          "when": "resourceExtname == .md && activeCustomEditorId != 'mdReview.editor'",
          "group": "navigation"
        },
        {
          "command": "mdReview.openSource",
          "when": "activeCustomEditorId == 'mdReview.editor'",
          "group": "navigation"
        },
        {
          "command": "mdReview.sendToClaude",
          "when": "activeCustomEditorId == 'mdReview.editor'",
          "group": "navigation@1"
        },
        {
          "command": "mdReview.exportWord",
          "when": "activeCustomEditorId == 'mdReview.editor'",
          "group": "mdReviewWord@1"
        },
        {
          "command": "mdReview.importWord",
          "when": "activeCustomEditorId == 'mdReview.editor'",
          "group": "mdReviewWord@2"
        }
      ],
      "explorer/context": [
        {
          "command": "mdReview.open",
          "when": "resourceExtname == .md",
          "group": "navigation"
        },
        {
          "command": "mdReview.sendFolderToClaude",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        }
      ],
      "commandPalette": [
        {
          "command": "mdReview.undo",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.redo",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.find",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.nextComment",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.previousComment",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.nextChange",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.previousChange",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.replyToThread",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.toggleOutline",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.sendToClaude",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.reviewWithClaude",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.zoomIn",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.zoomOut",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.zoomReset",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.readingView",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.sendFolderToClaude",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mdReview.addClaudeSkill",
          "when": "workspaceFolderCount > 0"
        },
        {
          "command": "mdReview.exportWord",
          "when": "activeCustomEditorId == 'mdReview.editor' || editorLangId == markdown"
        },
        {
          "command": "mdReview.importWord",
          "when": "activeCustomEditorId == 'mdReview.editor' || editorLangId == markdown"
        },
        {
          "command": "mdReview.addComment",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.submitReview",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.toggleComments",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.showShortcuts",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.severity1",
          "when": "false"
        },
        {
          "command": "mdReview.severity2",
          "when": "false"
        },
        {
          "command": "mdReview.severity3",
          "when": "false"
        },
        {
          "command": "mdReview.inbox.refresh",
          "when": "false"
        },
        {
          "command": "mdReview.inbox.sendAll",
          "when": "false"
        },
        {
          "command": "mdReview.openThread",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "mdReview.inbox.sendAll",
          "when": "view == mdReview.inbox && isWorkspaceTrusted",
          "group": "navigation@1"
        },
        {
          "command": "mdReview.inbox.refresh",
          "when": "view == mdReview.inbox",
          "group": "navigation@2"
        }
      ]
    },
    "configuration": {
      "title": "MD Review",
      "properties": {
        "mdReview.author": {
          "type": "string",
          "default": "",
          "description": "Name stamped on comments and replies you write. Empty uses your system user name."
        },
        "mdReview.showResolved": {
          "type": "boolean",
          "default": true,
          "description": "Show resolved threads in the sidebar."
        },
        "mdReview.pollFiles": {
          "type": "boolean",
          "default": false,
          "description": "Check the open file and its comments for changes every 2 seconds while the view is showing, for folders that don't report file changes (network shares, some remote or FUSE mounts). Network paths on Windows, including \\\\wsl$, are always checked this way."
        },
        "mdReview.agent.command": {
          "type": "string",
          "scope": "machine",
          "default": "claude",
          "markdownDescription": "Program started by **Send to Claude**, followed by the review prompt as its last argument. Extra arguments are allowed, e.g. `claude --permission-mode acceptEdits`. Quote a path with spaces: `\"C:\\Program Files\\Claude\\claude.exe\"`. When the program isn't on PATH, the usual install folders are checked too."
        },
        "mdReview.agent.launch": {
          "type": "string",
          "enum": [
            "direct",
            "shell"
          ],
          "default": "direct",
          "enumDescriptions": [
            "Start the agent as the terminal's own process; the terminal closes when it exits.",
            "Open your default shell and run the agent in it; the shell stays open afterwards (e.g. for `claude --continue`)."
          ],
          "description": "How Send to Claude starts the agent in its terminal."
        },
        "mdReview.agent.editMode": {
          "type": "string",
          "enum": [
            "edit",
            "suggest"
          ],
          "default": "edit",
          "enumDescriptions": [
            "Claude edits the Markdown and replies with what it changed.",
            "Claude proposes a replacement on each thread; you apply it with one click."
          ],
          "markdownDescription": "Whether **Send to Claude** asks Claude to edit the file or to suggest edits for you to apply."
        },
        "mdReview.agent.reviewComments": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "maximum": 50,
          "markdownDescription": "The most comments **Review with Claude** asks Claude to leave in one review."
        },
        "mdReview.agent.mode": {
          "type": "string",
          "enum": [
            "terminal",
            "clipboard"
          ],
          "default": "terminal",
          "enumDescriptions": [
            "Start the agent command in a new terminal (the prompt is also copied).",
            "Only copy the prompt to the clipboard, to paste into any agent."
          ],
          "description": "What Send to Claude does with the review prompt."
        }
      }
    },
    "keybindings": [
      {
        "command": "mdReview.severity1",
        "key": "alt+1",
        "when": "activeCustomEditorId == 'mdReview.editor' && mdReview.composing"
      },
      {
        "command": "mdReview.severity2",
        "key": "alt+2",
        "when": "activeCustomEditorId == 'mdReview.editor' && mdReview.composing"
      },
      {
        "command": "mdReview.severity3",
        "key": "alt+3",
        "when": "activeCustomEditorId == 'mdReview.editor' && mdReview.composing"
      },
      {
        "command": "mdReview.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.redo",
        "key": "ctrl+shift+z",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus",
        "mac": "cmd+shift+z"
      },
      {
        "command": "mdReview.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.nextComment",
        "key": "ctrl+alt+j",
        "mac": "cmd+alt+j",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.previousComment",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.nextChange",
        "key": "alt+f5",
        "mac": "cmd+alt+]",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.previousChange",
        "key": "shift+alt+f5",
        "mac": "cmd+alt+[",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.toggleOutline",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.zoomIn",
        "key": "ctrl+shift+=",
        "mac": "cmd+shift+=",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.zoomReset",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.zoomReset",
        "key": "ctrl+numpad0",
        "mac": "cmd+numpad0",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.addComment",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.replyToThread",
        "key": "ctrl+alt+y",
        "mac": "cmd+alt+y",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.submitReview",
        "key": "ctrl+shift+enter",
        "mac": "cmd+shift+enter",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.toggleComments",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.sendToClaude",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      },
      {
        "command": "mdReview.showShortcuts",
        "key": "ctrl+alt+,",
        "mac": "cmd+alt+,",
        "when": "activeCustomEditorId == 'mdReview.editor' && !inputFocus && !sideBarFocus && !panelFocus && !auxiliaryBarFocus && !terminalFocus"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "node esbuild.mjs",
    "test": "node --test test/*.test.mjs",
    "test:smoke": "node esbuild.mjs && node test/smoke/run.mjs",
    "package": "node esbuild.mjs && vsce package --no-dependencies",
    "preharness": "node esbuild.mjs",
    "harness": "node test/harness/server.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "highlight.js": "^11.12.0",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-mark": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-texmath": "^1.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "mermaid": "^12.0.0",
    "typescript": "^5.8.0"
  },
  "author": "Mustafa Akben",
  "repository": {
    "type": "git",
    "url": "https://github.com/mustafaakben/md-review.git"
  },
  "homepage": "https://github.com/mustafaakben/md-review#readme",
  "bugs": {
    "url": "https://github.com/mustafaakben/md-review/issues"
  },
  "keywords": [
    "markdown",
    "review",
    "comments",
    "ai",
    "agents",
    "claude",
    "codex",
    "manuscript",
    "writing"
  ],
  "icon": "media/icon.png"
}
