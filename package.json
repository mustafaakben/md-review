{
  "name": "md-review",
  "displayName": "MD Review",
  "description": "Review Markdown with AI agents: select-and-comment threads stored in a sidecar JSON that Claude, Codex, or any script can read and answer, plus light editing that only rewrites the bytes you changed.",
  "version": "0.1.0",
  "publisher": "mustafaakben",
  "license": "MIT",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "customEditors": [
      {
        "viewType": "mdReview.editor",
        "displayName": "MD Review",
        "selector": [
          {
            "filenamePattern": "*.md"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "mdReview.open",
        "title": "Open in MD Review",
        "category": "MD Review",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "mdReview.openSource",
        "title": "Open Markdown Source",
        "category": "MD Review",
        "icon": "$(go-to-file)"
      },
      {
        "command": "mdReview.undo",
        "title": "Undo Edit",
        "category": "MD Review"
      },
      {
        "command": "mdReview.redo",
        "title": "Redo Edit",
        "category": "MD Review"
      },
      {
        "command": "mdReview.find",
        "title": "Find in Document",
        "category": "MD Review"
      },
      {
        "command": "mdReview.nextComment",
        "title": "Next Comment",
        "category": "MD Review"
      },
      {
        "command": "mdReview.previousComment",
        "title": "Previous Comment",
        "category": "MD Review"
      },
      {
        "command": "mdReview.toggleOutline",
        "title": "Toggle Outline",
        "category": "MD Review",
        "icon": "$(list-tree)"
      },
      {
        "command": "mdReview.sendToClaude",
        "title": "Send Review to Claude",
        "category": "MD Review",
        "icon": "$(sparkle)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "mdReview.open",
          "when": "resourceExtname == .md && activeCustomEditorId != 'mdReview.editor'",
          "group": "navigation"
        },
        {
          "command": "mdReview.openSource",
          "when": "activeCustomEditorId == 'mdReview.editor'",
          "group": "navigation"
        },
        {
          "command": "mdReview.sendToClaude",
          "when": "activeCustomEditorId == 'mdReview.editor'",
          "group": "navigation@1"
        }
      ],
      "explorer/context": [
        {
          "command": "mdReview.open",
          "when": "resourceExtname == .md",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "mdReview.undo",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.redo",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.find",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.nextComment",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.previousComment",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.toggleOutline",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        },
        {
          "command": "mdReview.sendToClaude",
          "when": "activeCustomEditorId == 'mdReview.editor'"
        }
      ]
    },
    "configuration": {
      "title": "MD Review",
      "properties": {
        "mdReview.author": {
          "type": "string",
          "default": "",
          "description": "Name stamped on comments and replies you write. Empty uses your system user name."
        },
        "mdReview.showResolved": {
          "type": "boolean",
          "default": true,
          "description": "Show resolved threads in the sidebar."
        },
        "mdReview.agent.command": {
          "type": "string",
          "default": "claude",
          "markdownDescription": "Program started by **Send to Claude**, followed by the review prompt as its last argument. Extra arguments are allowed, e.g. `claude --permission-mode acceptEdits`."
        },
        "mdReview.agent.mode": {
          "type": "string",
          "enum": [
            "terminal",
            "clipboard"
          ],
          "default": "terminal",
          "enumDescriptions": [
            "Start the agent command in a new terminal (the prompt is also copied).",
            "Only copy the prompt to the clipboard, to paste into any agent."
          ],
          "description": "What Send to Claude does with the review prompt."
        }
      }
    },
    "keybindings": [
      {
        "command": "mdReview.undo",
        "key": "ctrl+z",
        "mac": "cmd+z",
        "when": "activeCustomEditorId == 'mdReview.editor'"
      },
      {
        "command": "mdReview.redo",
        "key": "ctrl+y",
        "mac": "cmd+shift+z",
        "when": "activeCustomEditorId == 'mdReview.editor'"
      },
      {
        "command": "mdReview.redo",
        "key": "ctrl+shift+z",
        "when": "activeCustomEditorId == 'mdReview.editor'"
      },
      {
        "command": "mdReview.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == 'mdReview.editor'"
      },
      {
        "command": "mdReview.nextComment",
        "key": "alt+down",
        "when": "activeCustomEditorId == 'mdReview.editor'"
      },
      {
        "command": "mdReview.previousComment",
        "key": "alt+up",
        "when": "activeCustomEditorId == 'mdReview.editor'"
      },
      {
        "command": "mdReview.toggleOutline",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeCustomEditorId == 'mdReview.editor'"
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "node esbuild.mjs",
    "test": "node --test test/*.test.mjs",
    "package": "node esbuild.mjs && vsce package --no-dependencies",
    "preharness": "node esbuild.mjs",
    "harness": "node test/harness/server.mjs"
  },
  "dependencies": {
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "markdown-it-attrs": "^4.3.1",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-sub": "^2.0.0",
    "markdown-it-sup": "^2.0.0",
    "markdown-it-texmath": "^1.0.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^3.6.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.0"
  },
  "author": "Mustafa Akben",
  "repository": {
    "type": "git",
    "url": "https://github.com/mustafaakben/md-review.git"
  },
  "homepage": "https://github.com/mustafaakben/md-review#readme",
  "bugs": {
    "url": "https://github.com/mustafaakben/md-review/issues"
  },
  "keywords": [
    "markdown",
    "review",
    "comments",
    "ai",
    "agents",
    "claude",
    "codex",
    "manuscript",
    "writing"
  ],
  "icon": "media/icon.png"
}
